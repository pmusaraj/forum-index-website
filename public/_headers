/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; style-src 'self'; img-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'

/app/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; style-src 'self'; img-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'none'
